{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otter",
  "identifier": "dev.otter.app",
  "build": {
    "beforeDevCommand": "npm run sidecars && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecars && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Otter",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 29 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/otter", "binaries/otterd"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDQTMwN0MyOEM2QzcyOTMKUldTVGNteU13Z2VqdkhDNC81OWwyVGh2VWZ1UmlHcnF2TVNGc1crVmVpU1A1NDY0RGpsL0RYOG8K",
      "endpoints": ["https://github.com/alvingaopro/otter/releases/latest/download/latest.json"]
    }
  }
}
