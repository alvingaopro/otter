{
  "name": "@otter/claude-runtime",
  "private": true,
  "version": "0.1.0",
  "description": "Otter's host-local worker: drives Claude through the official Claude Agent SDK and speaks versioned JSONL with otterd on stdin/stdout.",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test 'dist/**/*.test.js'"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.285"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
